{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantaedge.invalid/schemas/course-package.schema.json",
  "title": "QuantaEdge course definition package",
  "description": "K12 nested-course package v1. Server validates the package and imports all subjects, chapters, lessons and teaching blocks as a source-owned draft. Competitive and standalone assessment hierarchies use separate type-specific workflows until their schema/importers are implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "package_version",
    "course",
    "subjects"
  ],
  "properties": {
    "schema": {
      "const": "quantaedge.course-package.v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$"
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "display_name",
        "course_type_code",
        "curriculum_version"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,37}$",
          "maxLength": 38
        },
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "course_type_code": {
          "enum": [
            "K12"
          ]
        },
        "curriculum_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "class_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "stream_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "course_type_code": {
                "const": "K12"
              }
            },
            "required": [
              "course_type_code"
            ]
          },
          "then": {
            "required": [
              "class_code"
            ]
          }
        }
      ]
    },
    "subjects": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "display_name",
          "chapters"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "maxLength": 40
          },
          "display_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "sort_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "chapters": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "display_name",
                "lessons"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 60
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                },
                "sort_order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "source": {
                  "$ref": "#/$defs/sourceReference"
                },
                "lessons": {
                  "type": "array",
                  "maxItems": 2000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "code",
                      "title",
                      "blocks"
                    ],
                    "properties": {
                      "code": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "maxLength": 100
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "summary": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 800
                      },
                      "estimated_minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 120
                      },
                      "sort_order": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "source": {
                        "$ref": "#/$defs/sourceReference"
                      },
                      "blocks": {
                        "type": "array",
                        "maxItems": 200,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "sequence_no",
                            "block_type",
                            "content"
                          ],
                          "properties": {
                            "sequence_no": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            },
                            "block_type": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{1,39}$"
                            },
                            "content": {
                              "type": "object"
                            },
                            "active": {
                              "type": "boolean",
                              "default": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "source_rights_status": {
          "enum": [
            "UNCONFIRMED",
            "CLEARED_FOR_INTERNAL_USE",
            "CLEARED_FOR_PUBLIC_REPOSITORY",
            "DO_NOT_REDISTRIBUTE"
          ]
        }
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "maxLength": 2000
        },
        "edition": {
          "type": "string",
          "maxLength": 160
        },
        "pages": {
          "type": "string",
          "maxLength": 160
        }
      }
    }
  }
}
