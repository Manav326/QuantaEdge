# QuantaEdge production image deployment
QUANTAEDGE_GHCR_OWNER=Manav326
QUANTAEDGE_IMAGE_TAG=latest

# Public URLs
PUBLIC_API_BASE_URL=https://api.quantaedge.example
APP_CORS_ALLOWED_ORIGINS=https://quantaedge.example,https://admin.quantaedge.example,https://people.quantaedge.example
# These workspace origins must be distinct and match the deployed portal domains.
APP_AUTH_LEARNING_ORIGINS=https://quantaedge.example
APP_AUTH_EDUCATION_ADMIN_ORIGINS=https://admin.quantaedge.example
APP_AUTH_HRMS_ORIGINS=https://people.quantaedge.example
# Include every deployed browser origin above; this allowlist also protects state-changing requests from CSRF.
APP_ENVIRONMENT=production
APP_DEMO_SEED=false

# Database
POSTGRES_DB=quantaedge
POSTGRES_USER=quantaedge
POSTGRES_PASSWORD=change-this

# Published image deployment ports
API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001

# Set a strong, random secret before enabling admin content editing outside local preview mode.
QUANTAEDGE_ADMIN_TOKEN=

# Authentication: set these explicitly before production use.
# Required only for the first production start; use a unique 12–72 byte secret, then remove it after initialization.
APP_HRMS_BOOTSTRAP_PASSWORD=replace-with-strong-random-secret-before-first-start
APP_AUTH_ADMIN_MOBILES=
APP_AUTH_SESSION_HOURS=4
APP_AUTH_STAFF_ABSOLUTE_HOURS=8
APP_AUTH_LEARNING_ABSOLUTE_DAYS=30
APP_AUTH_SECURE_COOKIES=true
APP_AUTH_OTP_COOLDOWN_SECONDS=60
APP_OTP_PROVIDER_URL=
APP_OTP_PROVIDER_TOKEN=

# AI tutoring is disabled until enabled and the private inference endpoint is configured.
APP_AI_TUTOR_ENABLED=false
APP_AI_TUTOR_PRIMARY_BASE_URL=http://ollama:11434
APP_AI_TUTOR_PRIMARY_API_KEY=local-inference
APP_AI_TUTOR_PRIMARY_MODEL=qwen2.5:0.5b
APP_AI_TUTOR_PRIMARY_API_MODE=CHAT_COMPLETIONS
APP_AI_TUTOR_MIN_OUTPUT_CHARS=8

# Optional hosted API fallback. It is never called unless explicitly enabled.
APP_AI_TUTOR_FALLBACK_ENABLED=false
OPENAI_API_KEY=
APP_AI_TUTOR_FALLBACK_MODEL=gpt-5.6-luna
APP_AI_TUTOR_FALLBACK_BASE_URL=https://api.openai.com
APP_AI_TUTOR_FALLBACK_API_MODE=RESPONSES

# Google Meet uses a user-authorized OAuth refresh token; keep actual values in secret storage.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CALENDAR_ID=primary
GOOGLE_MEET_TIME_ZONE=Asia/Kolkata
