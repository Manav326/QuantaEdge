POSTGRES_DB=quantaedge
POSTGRES_USER=quantaedge
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
ADMIN_PORT=3001
PEOPLE_PORT=3002
API_PORT=8080
# Public website origin embedded into issued certificate QR codes (set to the real HTTPS domain in production).
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
APP_AUTH_LEARNING_ORIGINS=http://localhost:3000
APP_AUTH_EDUCATION_ADMIN_ORIGINS=http://localhost:3001
# Public Education Admin application origin used by HRMS handoff and the legacy /institution redirect.
# Set to the actual HTTPS Admin origin in production; the app is not the learner-facing website.
NEXT_PUBLIC_EDUCATION_ADMIN_ORIGIN=http://localhost:3001
# Server-owned institution scope for the Education Admin portal; browser headers cannot override this.
APP_EDUCATION_ADMIN_INSTITUTION_CODE=QUANTA-EDGE
APP_AUTH_HRMS_ORIGINS=http://localhost:3002
APP_DEMO_SEED=true
# The API exposes this public OAuth Web client ID to web and Android clients at runtime.
# No GitHub Actions secret is needed to compile the apps; configure the same audience on the API.
GOOGLE_WEB_CLIENT_ID=

# Optional Android push via Firebase Cloud Messaging. Push stays queued if these are blank.
APP_NOTIFICATIONS_FCM_PROJECT_ID=
# Base64-encoded Firebase service-account JSON; keep the real value in secret storage only.
APP_NOTIFICATIONS_FCM_SERVICE_ACCOUNT_JSON_BASE64=

# Optional Razorpay course checkout. Never commit live credentials or pass the secret to a client.
APP_RAZORPAY_KEY_ID=
APP_RAZORPAY_KEY_SECRET=
APP_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Optional RazorpayX Payouts. Keep live credentials and source bank account in deployment secret storage.
# Live transfers remain blocked until HRMS records the verified collection/funding legal arrangement.
APP_RAZORPAYX_KEY_ID=
APP_RAZORPAYX_KEY_SECRET=
APP_RAZORPAYX_ACCOUNT_NUMBER=
APP_RAZORPAYX_BASE_URL=https://api.razorpay.com/v1
APP_RAZORPAYX_WEBHOOK_SECRET=

# Local HTTP only; production must set this to true behind HTTPS.
APP_AUTH_SECURE_COOKIES=false
# Required to create/rotate institution join codes; use a random secret with 32+ characters.
# Keep this value private and stable across API restarts and deployments.
APP_INSTITUTION_CODE_ENCRYPTION_KEY=
APP_AUTH_SESSION_HOURS=4
# Local development bootstrap only; set an explicit allowlist in production.
APP_AUTH_ADMIN_MOBILES=7070107483
# Local development only; effective only while APP_DEMO_SEED=true.
APP_AUTH_ALLOW_REPEATED_DEMO_OTP=true

# Maximum active production child profiles per parent (raise to expand the limit).
APP_AUTH_MAX_CHILDREN_PER_PARENT=3

# Optional local admin content token; leave blank for preview-only editing.
QUANTAEDGE_ADMIN_TOKEN=

# Optional local AI question-generation CLI; no model calls occur without explicit flags.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
QUANTAEDGE_QUESTION_MODEL=

# Google Calendar / Meet integration. Put real credentials in deployment secrets only.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CALENDAR_ID=primary
GOOGLE_MEET_TIME_ZONE=Asia/Kolkata
