{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantaedge.invalid/schemas/portable-assessment-package.schema.json",
  "title": "QuantaEdge portable assessment package",
  "description": "Course-neutral assessment content. Institution/course/chapter binding is a separate deployment operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "package_version",
    "title",
    "assessment_type",
    "subject",
    "source",
    "configuration",
    "questions",
    "editorial",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "quantaedge.portable-assessment-package.v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 1200
    },
    "assessment_type": {
      "enum": [
        "PREVIOUS_YEAR_PAPER",
        "MOCK_EXAM",
        "DIAGNOSTIC",
        "PRACTICE_SET"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "domain_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "language": {
          "enum": [
            "en",
            "hi",
            "ur",
            "bn",
            "mixed",
            "other"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "exam_name",
        "cycle",
        "source_url",
        "source_status",
        "repository_distribution_rights",
        "available_languages"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "exam_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "cycle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "exam_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "paper_title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_status": {
          "enum": [
            "DISCOVERED",
            "READABLE_ON_WEB_NOT_DOWNLOADED_LOCALLY",
            "DOWNLOADED_PENDING_REVIEW",
            "VERIFIED_SOURCE_FILE",
            "SOURCE_UNAVAILABLE"
          ]
        },
        "source_file_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "source_file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "repository_distribution_rights": {
          "enum": [
            "UNCONFIRMED",
            "CLEARED_FOR_INTERNAL_USE",
            "CLEARED_FOR_PUBLIC_REPOSITORY",
            "DO_NOT_REDISTRIBUTE"
          ]
        },
        "rights_evidence_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "available_languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
          },
          "uniqueItems": true,
          "maxItems": 12
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_minutes",
        "marks_per_question",
        "negative_marking_fraction",
        "unanswered_mark"
      ],
      "properties": {
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "marks_per_question": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "unanswered_mark": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "presentation_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 30
        },
        "negative_marking_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of a question's marks deducted for a wrong answer. 0 = no penalty; 0.25 = one-quarter penalty."
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_question_number",
          "source_location",
          "question_type",
          "prompt",
          "options",
          "topic_tags",
          "proposed_answer",
          "section_code",
          "prompt_i18n"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
          },
          "source_question_number": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            ]
          },
          "source_location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pdf_page"
            ],
            "properties": {
              "pdf_page": {
                "type": "integer",
                "minimum": 1
              },
              "printed_page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "booklet_series": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "source_language_page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "PDF page containing this source-language version."
              }
            }
          },
          "question_type": {
            "enum": [
              "MCQ",
              "TRUE_FALSE"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "text",
                "text_i18n"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                "text_i18n": {
                  "type": "object",
                  "minProperties": 1,
                  "patternProperties": {
                    "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1500
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "topic_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "secondary_topic_tags": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "marks": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "proposed_answer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_key",
              "confidence",
              "explanation",
              "answer_source",
              "review_status",
              "explanation_i18n",
              "solution_mode"
            ],
            "properties": {
              "option_key": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "UNRESOLVED"
                ]
              },
              "explanation": {
                "type": "string",
                "maxLength": 700,
                "description": "Concise explanation: state the decisive reason, not a long lesson."
              },
              "answer_source": {
                "enum": [
                  "OFFICIAL_KEY",
                  "OFFICIAL_KEY_CROSS_CHECKED",
                  "INDEPENDENTLY_SOLVED",
                  "THIRD_PARTY_KEY",
                  "UNRESOLVED"
                ]
              },
              "answer_reference_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "review_status": {
                "const": "PENDING_HUMAN_REVIEW"
              },
              "reviewer_notes": {
                "type": "string",
                "maxLength": 2000
              },
              "explanation_i18n": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                    "type": "string",
                    "maxLength": 700
                  }
                },
                "additionalProperties": false,
                "description": "Concise source-language explanation. Keep it direct and easy to understand."
              },
              "solution_mode": {
                "enum": [
                  "CONCISE",
                  "STEPWISE"
                ],
                "description": "Use STEPWISE for numerical/formula/code-tracing questions that require working; otherwise CONCISE."
              },
              "solution_steps_i18n": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  }
                },
                "additionalProperties": false,
                "description": "For numerical or procedural solutions, short ordered steps before the final answer. Omit for concise direct answers."
              }
            }
          },
          "question_review_status": {
            "const": "PENDING_HUMAN_REVIEW"
          },
          "source_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "section_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,49}$",
            "description": "Exam-defined result section such as GENERAL_STUDIES, COMPUTER_SCIENCE or LANGUAGE_QUALIFYING."
          },
          "section_name_i18n": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "additionalProperties": false
          },
          "prompt_i18n": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "additionalProperties": false,
            "description": "Original source wording per language. Keep it, even if a separate approved UI translation exists."
          },
          "section_result_policy": {
            "enum": [
              "SCORED",
              "QUALIFYING_ONLY",
              "PRACTICE_ONLY"
            ],
            "description": "A qualifying-only section is reported separately and excluded from the aggregate GS + subject score."
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "student_delivery_allowed",
        "review_status"
      ],
      "properties": {
        "status": {
          "const": "DRAFT"
        },
        "student_delivery_allowed": {
          "const": false
        },
        "review_status": {
          "const": "PENDING_HUMAN_REVIEW"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "course_binding": {
      "description": "Forbidden in portable packages; attach course/tenant/chapter via a separate validated deployment manifest.",
      "not": {}
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name_i18n",
          "question_count",
          "result_policy"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,49}$"
          },
          "name_i18n": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "additionalProperties": false
          },
          "question_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250
          },
          "result_policy": {
            "enum": [
              "SCORED",
              "QUALIFYING_ONLY",
              "PRACTICE_ONLY"
            ]
          }
        }
      }
    }
  }
}
