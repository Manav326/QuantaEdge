POSTGRES_DB=quantaedge
POSTGRES_USER=quantaedge
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
ADMIN_PORT=3001
PEOPLE_PORT=3002
API_PORT=8080
# Public website origin embedded into issued certificate QR codes (set to the real HTTPS domain in production).
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
APP_AUTH_LEARNING_ORIGINS=http://localhost:3000
APP_AUTH_EDUCATION_ADMIN_ORIGINS=http://localhost:3001
APP_AUTH_HRMS_ORIGINS=http://localhost:3002
APP_DEMO_SEED=true
# Local HTTP only; production must set this to true behind HTTPS.
APP_AUTH_SECURE_COOKIES=false
APP_AUTH_SESSION_HOURS=4
# Local development bootstrap only; set an explicit allowlist in production.
APP_AUTH_ADMIN_MOBILES=7070107483
# Local development only; effective only while APP_DEMO_SEED=true.
APP_AUTH_ALLOW_REPEATED_DEMO_OTP=true

# Maximum active production child profiles per parent (raise to expand the limit).
APP_AUTH_MAX_CHILDREN_PER_PARENT=3

# Optional local admin content token; leave blank for preview-only editing.
QUANTAEDGE_ADMIN_TOKEN=

# Optional local AI question-generation CLI; no model calls occur without explicit flags.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
QUANTAEDGE_QUESTION_MODEL=

# Google Calendar / Meet integration. Put real credentials in deployment secrets only.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CALENDAR_ID=primary
GOOGLE_MEET_TIME_ZONE=Asia/Kolkata
