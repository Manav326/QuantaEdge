# QuantaEdge production image deployment
QUANTAEDGE_GHCR_OWNER=Manav326
QUANTAEDGE_IMAGE_TAG=latest

# Public URLs
PUBLIC_API_BASE_URL=https://api.quantaedge.example
APP_CORS_ALLOWED_ORIGINS=https://quantaedge.example,https://admin.quantaedge.example
APP_DEMO_SEED=false

# Database
POSTGRES_DB=quantaedge
POSTGRES_USER=quantaedge
POSTGRES_PASSWORD=change-this

# Published image deployment ports
API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001

# Set a strong, random secret before enabling admin content editing outside local preview mode.
QUANTAEDGE_ADMIN_TOKEN=
