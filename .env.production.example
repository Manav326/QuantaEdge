# QuantaEdge production image deployment
QUANTAEDGE_GHCR_OWNER=Manav326
QUANTAEDGE_IMAGE_TAG=latest

# Public URLs
PUBLIC_API_BASE_URL=https://api.quantaedge.example
APP_CORS_ALLOWED_ORIGINS=https://quantaedge.example,https://admin.quantaedge.example
APP_DEMO_SEED=false

# Database
POSTGRES_DB=quantaedge
POSTGRES_USER=quantaedge
POSTGRES_PASSWORD=change-this

# Published image deployment ports
API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001

# Set a strong, random secret before enabling admin content editing outside local preview mode.
QUANTAEDGE_ADMIN_TOKEN=

# Authentication: set these explicitly before production use.
APP_AUTH_ADMIN_MOBILES=
APP_AUTH_SESSION_HOURS=168
APP_AUTH_SECURE_COOKIES=true
APP_AUTH_OTP_COOLDOWN_SECONDS=60
APP_OTP_PROVIDER_URL=
APP_OTP_PROVIDER_TOKEN=

# AI tutoring is disabled until enabled and configured intentionally.
APP_AI_TUTOR_ENABLED=false
OPENAI_API_KEY=
APP_AI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_API_BASE_URL=https://api.openai.com
