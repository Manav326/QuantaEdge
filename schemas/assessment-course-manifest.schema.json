{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantaedge.in/schemas/assessment-course-manifest.schema.json",
  "title": "QuantaEdge Assessment Course Import Manifest",
  "description": "Configuration for the portable assessment importer. Missing course fields may be entered interactively. Database-generated public IDs are not supplied in this file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quantaedge.assessment-course-manifest.v1"
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{1,37}$",
          "description": "Stable logical course key, not the generated public ID. Example: BPSC_TRE_CS_PYQ_SERIES."
        },
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["BPSC TRE Computer Science — Previous-Year Practice Series"]
        },
        "curriculum_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "examples": ["BPSC-TRE-CS-PYQ-SERIES"]
        },
        "stream_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "default": "ASSESSMENT"
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Path to one quantaedge.portable-assessment-package.v1 JSON file, relative to this manifest or absolute."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "examples": [
    {
      "schema": "quantaedge.assessment-course-manifest.v1",
      "course": {
        "code": "BPSC_TRE_CS_PYQ_SERIES",
        "display_name": "BPSC TRE Computer Science — Previous-Year Practice Series",
        "curriculum_version": "BPSC-TRE-CS-PYQ-SERIES",
        "stream_code": "ASSESSMENT"
      },
      "packages": [
        "packages/tre-1.json",
        "packages/tre-2.json",
        "packages/tre-3.json"
      ]
    }
  ]
}